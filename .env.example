# Шаблон переменных окружения. Реальный .env в git НЕ коммитится.
# На Railway эти же значения задаются во вкладке Variables.

# --- база данных (Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# --- админ-панель /admin (обязательно сменить!) ---
ADMIN_PANEL_PASSWORD=

# --- общий секрет backend <-> telegram_bot (одинаковый в обоих сервисах) ---
# сгенерировать: python3 -c "import secrets; print(secrets.token_hex(24))"
INTERNAL_SECRET=

# --- Telegram-бот ---
BOT_TOKEN=
ADMIN_CHAT_ID=
BACKEND_URL=https://ваш-backend.up.railway.app
AUTO_START_BOT=0

# --- письма с OTP (Brevo HTTP API, SMTP на Railway заблокирован) ---
BREVO_API_KEY=
EMAIL_HOST_USER=
EMAIL_FROM_NAME=StroyAI

# --- домены сайта, которым разрешён доступ к API ---
CORS_ALLOWED_ORIGINS=https://ваш-сайт.vercel.app

# --- LLM: ИИ-консультант поддержки и ИИ-Дизайн ---
# Вариант А, официальный Anthropic: достаточно одного LLM_API_KEY
# Вариант Б, OpenAI-совместимый шлюз: раскомментируйте три строки ниже
LLM_API_KEY=
# LLM_PROTOCOL=openai
# LLM_BASE_URL=https://адрес-шлюза.com
# LLM_MODEL=имя-модели-из-списка-шлюза
LLM_TIMEOUT=60
